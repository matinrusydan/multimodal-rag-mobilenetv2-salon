# Allow only backend build inputs; do not upload the whole research workspace.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps/
!apps/api/
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/knexfile.ts
!apps/api/Dockerfile
!apps/api/src/
!apps/api/src/**
!apps/api/tests/
!apps/api/tests/**
!apps/ai/
!apps/ai/Dockerfile
!apps/ai/requirements-rag.lock.txt
!apps/ai/app/
!apps/ai/app/**
!apps/ai/rag/
!apps/ai/rag/runtime/
!apps/ai/rag/runtime/**
!packages/
!packages/shared-types/
!packages/shared-types/**
!packages/shared-utils/
!packages/shared-utils/**

# These remain excluded even if accidentally placed inside a source directory.
**/node_modules
**/dist
**/coverage
**/.env
**/.env.*
**/*.credentials
**/*.credentials.*
**/.venv*
**/__pycache__
**/.pytest_cache
**/*.pyc
**/*.log
**/*.onnx
**/*.pth
**/*.pt
**/*.safetensors
**/*.zip
**/*.pdf
