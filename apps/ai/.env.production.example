# Headless Linux production profile: no paid API fallback.
AI_ENV=production
AI_HOST=0.0.0.0
# Railway/Render injects PORT; Docker consumes it directly.
PORT=5000
AI_LLM_PROVIDER=chatgpt
# Fill with a model authorized by this application's ChatGPT grant.
AI_CHATGPT_MODEL=
AI_INTERNAL_TOKEN=
# Private Express service origin including http:// or https://.
API_BASE_URL=
RAG_RETRIEVAL_PROVIDER=bm25_source_balanced
RAG_LIVE_SERVICES=true
RAG_CONTEXT_SELECTION=source_scoped
RAG_CONTEXT_STRATEGY=head
RAG_RUNTIME_CORPUS_FILE=./rag/runtime/curated-care-v1/corpus.json
RAG_GENERATION_TIMEOUT_SECONDS=50
WEB_FALLBACK_ENABLED=true
# Mount a persistent private volume at /data; UID/GID 10001 must have write access.
XDG_DATA_HOME=/data
RAG_KNOWLEDGE_DIR=/data/knowledge
PYTHON_DOTENV_DISABLED=1
