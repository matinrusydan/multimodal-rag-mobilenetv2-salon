{
  "name": "ai",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/freeport.mjs 5000 -- .venv\\Scripts\\python.exe -m uvicorn app.main:app --port 5000 --host 127.0.0.1",
    "dev:reload": "node ../../scripts/freeport.mjs 5000 -- .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 5000 --host 127.0.0.1",
    "start": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --port 5000 --host 127.0.0.1",
    "start:rag": ".venv\\Scripts\\python.exe -m uvicorn app.rag_app:app --port 5000 --host 127.0.0.1",
    "rag:check": ".venv\\Scripts\\python.exe -m app.rag.preflight --check-catalog",
    "test": ".venv\\Scripts\\python.exe -m pytest tests -q",
    "test:rag": ".venv\\Scripts\\python.exe -m pytest tests -q -p no:cacheprovider --ignore-glob=*test_cv_*.py --ignore=tests/test_hair_features.py",
    "rag:smoke": ".venv\\Scripts\\python.exe -m app.rag.smoke_runtime --check-proxy",
    "crawl:site": ".venv\\Scripts\\python.exe -m app.crawler.crawl_site",
    "crawl:tips": ".venv\\Scripts\\python.exe -m app.crawler.crawl_tips",
    "rag:ingest": ".venv\\Scripts\\python.exe -m app.rag.ingest",
    "rag:sync-catalog": ".venv\\Scripts\\python.exe -m app.rag.sync_catalog"
  }
}
