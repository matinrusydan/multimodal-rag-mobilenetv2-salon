# Prototype penelitian lokal: ChatGPT-plan OAuth + BM25, tanpa API key berbayar.
AI_LLM_PROVIDER=chatgpt
RAG_RETRIEVAL_PROVIDER=bm25_source_balanced
# Isi slug dari `python -m app.chatgpt_auth models` setelah login aplikasi.
AI_CHATGPT_MODEL=
WEB_FALLBACK_ENABLED=true
RAG_CONTEXT_STRATEGY=head
RAG_CONTEXT_SELECTION=source_scoped
RAG_GENERATION_TIMEOUT_SECONDS=50
RAG_LIVE_SERVICES=true
RAG_RUNTIME_CORPUS_FILE=./rag/runtime/curated-care-v1/corpus.json
API_BASE_URL=http://127.0.0.1:4000
# Default corpus: apps/ai/rag/eval/curated-development-v2/corpus.json
# Route chat memakai layanan aktif dari API; evaluasi Python tetap snapshot secara default.
# Tidak menggunakan OPENAI_API_KEY atau kredensial Codex.
