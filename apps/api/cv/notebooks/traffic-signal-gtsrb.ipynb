    "### Section 2: DATA LOADING & PREPROCESSING\n",
    "\n",
    "### Penjelasan\n",
    "\n",
    "Bagian ini mengatur loading dan preprocessing dataset GTSRB:\n",
    "- **Dataset loading**: Load dari folder structure GTSRB\n",
    - **Preprocessing basic**: Resize to 32x32, Normalize with ImageNet stats\n",
    "- **Train/validation/test split**: Proper stratified splits\n",
    "- **Data transformations**: Basic preprocessing without augmentation\n",
    "- **Weighted sampling**: Handle class imbalance dengan weighted sampler"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "data-preprocessing",
   "metadata": {},
   "outputs": [],
   "source": [
    "from torchvision import datasets, transforms\n",
    "from torch.utils.data import DataLoader, WeightedRandomSampler\n",
    "\n",
    "# Transformations for training and validation\n",
    "train_transforms = Compose([\n",
    "    transforms.Resize((INPUT_SIZE, INPUT_SIZE)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n",
    "])\n",
    "\n",
    "val_transforms = Compose([\n",
    "    transforms.Resize((INPUT_SIZE, INPUT_SIZE)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n",
    "])\n",
    "\n",
    "# Load GTSRB dataset\n",
    "train_dataset = datasets.GTSRB(\n",
    "    root=DATASET_PATH,\n",
    "    split='Train',\n",
    "    download=True,\n",
    "    transform=train_transforms\n",
    ")\n",
    "\n",
    "# Create test set (use first 1000 samples from training for testing)\n",
    "test_dataset = datasets.GTSRB(\n",
    "    root=DATASET_PATH,\n",
    "    split='Test',\n",
    "    download=True,\n",
    "    transform=val_transforms\n",
    ")\n",
    "\n",
    "print(f\"Training samples: {len(train_dataset)}\")\n",
    "print(f\"Validation samples: {len(test_dataset)}\")\n",
    "\n",
    "# Calculate class weights for handling class imbalance\n",
    "class_counts = train_dataset.target.bincount()\n",
    "total_samples = len(class_counts)\n",
    "class_weights = total_samples / (len(class_counts) * class_counts.float())\n",
    "class_weights = class_weights.double()\n",
    "\n",
    "# Create weight sampler for imbalanced classes\n",
    "sample_weights = class_weights[train_dataset.target]\n",
    "weight_sampler = WeightedRandomSampler(\n",
    "    weights=sample_weights,\n",
    "    num_samples=len(sample_weights),\n",
    "    replacement=True\n",
    ")\n",
    "\n",
    "train_loader = DataLoader(\n",
    "    train_dataset,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    sampler=weight_sampler,\n",
    "    shuffle=False,\n",
    "    num_workers=2,\n",
    "    pin_memory=True\n",
    ")\n",
    "\n",
    "test_loader = DataLoader(\n",
    "    test_dataset,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    shuffle=False,\n",
    "    num_workers=2,\n",
    "    pin_memory=True\n",
    ")\n",
    "\n",
    "print(f\"\\nClass distribution in training set:\")\n",
    "for i, count in enumerate(class_counts):\n",
    "    print(f\"Class {i}: {count} samples\")\n",
    "print(f\"\\nSample weights mean: {sample_weights.mean():.2f}\")\n",
    "print(f\"Weighted sampling enabled: {'Yes' if weight_sampler.num_samples != len(sample_weights) else 'No'}\")"
   ],
   "outputs": []
