   "metadata": {},
   "outputs": [],
   "source": [
    "# Advanced techniques\n",
    "\n",
    "# 1. Label Smoothing (prevent overconfidence)\n",
    "def apply_label_smoothing(labels, num_classes, epsilon=0.1):\n",
    "    \"\"\"Apply label smoothing to prevent overconfidence.\"\"\"\n",
    "    one_hot = torch.zeros_like(labels, dtype=torch.float32)\n",
    "    one_hot.scatter_(1, labels.unsqueeze(-1), 1.0)\n",
    "    smoothed_labels = one_hot * (1 - epsilon) + epsilon / num_classes\n",
    "    return smoothed_labels\n",
    "\n",
    "# Test label smoothing\n",
    "test_labels = torch.tensor([0, 1, 2, 3])\n",
    "smoothed_labels = apply_label_smoothing(test_labels, NUM_CLASSES, epsilon=0.1)\n",
    "print(f\"\\nExample label smoothing (epsilon=0.1):\")\n",
    "print(f\"Original: {test_labels}\")\n",
    "print(f\"Smoothed: {smoothed_labels[0]}\")\n",
    "\n",
    "# 2. Temperature Scaling Calibration\n",
    "def temperature_scaling(logits, temperature=1.0):\n",
    "    \"\"\"Calibrate predictions using temperature scaling.\"\"\"\n",
    "    scaled_logits = logits / temperature\n",
    "    return F.softmax(scaled_logits, dim=-1)\n",
    "\n",
    "# Example temperature scaling\n",
    "test_logits = torch.randn(NUM_CLASSES)  # Example logits\n",
    "temp_scaled = temperature_scaling(test_logits, temperature=2.0)\n",
    "print(f\"\\nOriginal softmax probabilities: {F.softmax(test_logits, dim=-1)[0]:.3f}\")\n",
    "print(f\"Scaled (T=2.0) probabilities: {temp_scaled[0]:.3f}\")\n",
    "print(f\"Temperature scaling reduces confidence (calibration)\")\n",
    "\n",
    "# 3. Ensemble prediction example\n",
    "def ensemble_predictions(models, inputs, temperatures=None):\n",
    "    \"\"\"Average ensemble predictions.\"\"\"\n    logits_list = []\n    for model in models:\n        with torch.no_grad():\n            logits = model(inputs)\n            if temperatures and len(temperatures) > 0:\n                logits = logits / temperatures[model]\n            logits_list.append(logits)\n    avg_logits = sum(logits_list) / len(logits_list)\n    return F.softmax(avg_logits, dim=-1)\n\nprint(f\"\\nEnsemble method ready for multiple model predictions\")"
   ],
   "outputs": []
