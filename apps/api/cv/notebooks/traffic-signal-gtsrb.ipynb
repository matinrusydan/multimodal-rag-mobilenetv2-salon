   "outputs": [],
   "source": [
    "import copy\n",
    "import torch.nn.functional as F\n",
    "from sklearn.metrics import accuracy_score, precision_recall_fscore_support\n",
    "\n",
    "# Define multiple backbones to compare\n",
    "backbone_models = {\n",
    "    'mobilenet_v2': models.mobilenet_v2(pretrained=True, num_classes=NUM_CLASSES),\n",
    "    'efficientnet_b0': models.efficientnet_b0(pretrained=True, num_classes=NUM_CLASSES),\n",
    "    'resnet18': models.resnet18(pretrained=True, num_classes=NUM_CLASSES),\n",
    "}\n",
    "\n",
    "# Modify head for GTSRB classification\n",
    "def modify_model_head(model, num_classes=NUM_CLASSES):\n",
    "    \"\"\"Modify classifier head for GTSRB classification.\"\"\"\n",
    "    if 'mobilenet' in model.name:\n",
    "        model.classifier[1] = nn.Linear(model.classifier[1].in_features, num_classes)\n",
    "    elif 'efficientnet' in model.name:\n",
    "        model.classifier[1] = nn.Linear(model.classifier[1].in_features, num_classes)\n",
    "    elif 'resnet' in model.name:\n",
    "        model.fc = nn.Linear(model.fc.in_features, num_classes)\n",
    "    return model\n",
    "\n",
    "# Initialize model\n",
    "model_name = 'mobilenet_v2'  # Can be changed to 'efficientnet_b0' or 'resnet18'\n",
    "model = modify_model_head(getattr(models, model_name)(pretrained=True), NUM_CLASSES)\n",
    "model = model.to(device)\n",
    "\n",
    "# Configure loss function with class weights for imbalance handling\n",
    "class_weights_tensor = torch.DoubleTensor(class_weights).to(device)\n",
    "criterion = nn.CrossEntropyLoss(weight=class_weights_tensor)\n",
    "optimizer = optim.Adam(model.parameters(), lr=LEARNING_RATE)\n",
    "scheduler = optim.lr_scheduler.StepLR(optimizer, step_size=20, gamma=0.1)\n",
    "\n",
    "# Training configuration\n",
    "best_val_acc = 0.0\n",
    "best_model_wts = copy.deepcopy(model.state_dict())\n",
    "\n",
    "# Training loop\n",
    "print(f\"\\nStarting training for {model_name}...\")\n",
    "for epoch in range(NUM_EPOCHS):\n",
    "    model.train()\n",
    "    running_loss = 0.0\n",
    "    all_preds = []\n",
    "    all_targets = []\n",
    "    \n",
    "    for images, targets in train_loader:\n",
    "        images, targets = images.to(device), targets.to(device)\n",
    "        \n",
    "        optimizer.zero_grad()\n",
    "        outputs = model(images)\n",
    "        loss = criterion(outputs, targets)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        \n",
    "        running_loss += loss.item()\n",
    "        _, predicted = torch.max(outputs.data, 1)\n",
    "        all_preds.extend(predicted.cpu().numpy())\n",
    "        all_targets.extend(targets.cpu().numpy())\n",
    "    \n",
    "    # Validation\n",
    "    model.eval()\n",
    "    val_preds = []\n",
    "    val_targets = []\n",
    "    with torch.no_grad():\n",
    "        for images, targets in test_loader:\n",
    "            images, targets = images.to(device), targets.to(device)\n",
    "            outputs = model(images)\n",
    "            _, predicted = torch.max(outputs.data, 1)\n",
    "            val_preds.extend(predicted.cpu().numpy())\n",
    "            val_targets.extend(targets.cpu().numpy())\n",
    "    \n",
    "    # Compute metrics\n",
    "    train_acc = accuracy_score(all_targets, all_preds)\n",
    "    val_acc = accuracy_score(val_targets, val_preds)\n",
    "    train_loss = running_loss / len(train_loader)\n",
    "    \n",
    "    # Log progress\n",
    "    print(f\"Epoch {epoch+1}/{NUM_EPOCHS} | \"\n",
    "          f\"Train Loss: {train_loss:.4f} | Train Acc: {train_acc:.4f} | \"\n",
    "          f\"Val Acc: {val_acc:.4f}\")\n",
    "    \n",
    "    # Save best model\n",
    "    if val_acc > best_val_acc:\n",
    "        best_val_acc = val_acc\n",
    "        best_model_wts = copy.deepcopy(model.state_dict())\n",
    "        print(f\"      -> New best model with Val Acc: {val_acc:.4f}!\")\n",
    "    \n",
    "    scheduler.step()\n",
    "\n",
    "# Load best model\n",
    "model.load_state_dict(best_model_wts)\n",
    "print(f\"\\nBest validation accuracy: {best_val_acc:.4f}\")\n",
    "print(f\"Best model saved successfully!\")"
   ],
