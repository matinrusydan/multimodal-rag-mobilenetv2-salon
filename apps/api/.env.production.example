# Configure these in Railway/Render, not in a committed .env file.
NODE_ENV=production
HOST=0.0.0.0
# The platform may inject PORT; do not override its assigned port.
PORT=4000
DATABASE_URL=
DB_CLIENT=postgres
DB_POOL_MIN=0
DB_POOL_MAX=10
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Private AI service origin including http:// or https://.
AI_URL=
# Same secret as AI_INTERNAL_TOKEN on the AI service; at least 32 random characters.
AI_INTERNAL_TOKEN=
SECURITY_ENFORCE_ENABLED=true
CORS_ORIGIN=https://your-project.vercel.app
# false or a verified fixed ingress hop count 1..5; never use true.
TRUST_PROXY=false
