# apps/api — Express backend
PORT=4000
HOST=127.0.0.1

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rag_salon
DB_CLIENT=postgres
DB_POOL_MIN=0
DB_POOL_MAX=10

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Brain engine
AI_URL=http://127.0.0.1:5000
# Harus sama dengan AI_INTERNAL_TOKEN di apps/ai
AI_INTERNAL_TOKEN=dev-internal-token-change-me

SECURITY_ENFORCE_ENABLED=true
CORS_ORIGIN=http://localhost:3000
