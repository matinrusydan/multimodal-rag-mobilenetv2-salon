# Normalize line endings: repository stores LF, working tree can use platform default.
* text=auto eol=lf

# Explicitly binary (never touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.onnx binary
*.onnx.data binary
*.pth binary
*.pt binary
*.sqlite binary
*.sqlite-wal binary
*.sqlite-shm binary

# Windows scripts may keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Versioned research packages contain byte-level hashes. Preserve their exact
# bytes on every platform so checkout normalization cannot invalidate manifests.
apps/ai/rag/eval/** -text -eol
