# ===== Root (informasi umum) =====
NODE_ENV=development

# ===== apps/api (Express, port 4000) =====
PORT=4000
HOST=127.0.0.1

# Database (PostgreSQL, port 5432 = v17)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rag_salon
DB_CLIENT=postgres
DB_POOL_MIN=0
DB_POOL_MAX=10

# Auth / JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Brain engine (FastAPI apps/ai) — proxy target untuk /api/analyze & /api/chat
AI_URL=http://127.0.0.1:5000

# Token internal bersama (apps/ai memakainya untuk memanggil API Express saat tool-call agent).
# WAJIB sama dengan AI_INTERNAL_TOKEN di apps/ai.
AI_INTERNAL_TOKEN=dev-internal-token-change-me

# Security / RBAC
SECURITY_ENFORCE_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# ===== apps/ai (FastAPI brain engine, port 5000) =====
AI_PORT=5000
AI_HOST=127.0.0.1

# Gemini (embed + LLM)
GEMINI_API_KEY=...
AI_EMBEDDING_PROVIDER=gemini
AI_LLM_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIM=768
AI_LLM_MODEL=gemini-3.6-flash
AI_LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-flash-latest

# ChromaDB (persistent | http)
AI_CHROMA_MODE=persistent
CHROMA_URL=http://127.0.0.1:8000
CHROMA_PERSIST_DIR=./chroma_db

# RAG tuning
RAG_TOP_K=5
RAG_CATALOG_TOPIC=katalog

# Agent admin: base URL Express + token internal (harus sama dgn apps/api)
API_BASE_URL=http://127.0.0.1:4000
AI_INTERNAL_TOKEN=dev-internal-token-change-me

# Live web fallback (kesehatan rambut)
WEB_FALLBACK_ENABLED=true
WEB_FALLBACK_MAX_DOCS=2

# Crawler (knowledge base)
CRAWL_BASE_URL=http://127.0.0.1:3000
CRAWL_USE_BROWSER=false
CRAWL_DELAY_MS=1500
CRAWL_TIPS_URL=https://www.alodokter.com
CRAWL_TIPS_URLS=https://www.alodokter.com,https://hellosehat.com/rambut/,https://www.halodoc.com/artikel/tag/rambut,https://www.healthline.com/health/hair-loss

# CV (ONNX)
MODEL_LENGTH_PATH=./cv/weights/hair_length.onnx
MODEL_TYPE_PATH=./cv/weights/hair_type.onnx
CONFIDENCE_THRESHOLD=0.5

# ===== apps/web (Next.js, port 3000) =====
BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api
SESSION_SECRET=change-me-session-secret
