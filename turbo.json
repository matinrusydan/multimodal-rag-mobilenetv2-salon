{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "api#build": {
      "outputs": []
    },
    "api#test": {
      "outputs": []
    },
    "web#test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "ai#dev": {
      "cache": false,
      "persistent": true
    },
    "crawl:site": {
      "cache": false
    },
    "crawl:tips": {
      "cache": false
    },
    "rag:ingest": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "migrate": {
      "cache": false
    },
    "seed": {
      "dependsOn": ["migrate"],
      "cache": false
    }
  }
}
